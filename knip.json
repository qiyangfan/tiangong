{
  "ignoreDependencies": ["pino-pretty"],
  "ignoreBinaries": ["hadolint", "trivy"],
  "ignore": ["apps/miniapp/src/uni_modules/**"],
  "ignoreWorkspaces": ["apps/miniapp"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/main.ts", "scripts/gen-crud.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": ["index.html"]
    },
    "apps/e2e": {
      "entry": ["tests/**/*.spec.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"]
    }
  }
}
