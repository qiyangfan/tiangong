{
  "name": "@tiangong/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "天工端到端验收（Playwright 驱动真实 api + web + PostgreSQL）",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:coverage": "rm -rf .nyc_output && E2E_COVERAGE=1 playwright test && nyc report && nyc check-coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "nyc": {
    "cwd": "../web",
    "include": [
      "src/**/*.ts",
      "src/**/*.vue"
    ],
    "extension": [
      ".ts",
      ".vue"
    ],
    "reporter": [
      "text-summary"
    ],
    "temp-dir": "../e2e/.nyc_output",
    "check-coverage": true,
    "statements": 83,
    "branches": 59,
    "functions": 76,
    "lines": 83
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.1",
    "nyc": "^18.0.0",
    "typescript": "^5.9.3"
  }
}
