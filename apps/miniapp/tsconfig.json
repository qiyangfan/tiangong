{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    // 基座 target/lib 为 ES2023；uni-app 工具链按 ES2020 转译，产物语义以它为准，故本包覆写回 ES2020
    "target": "ES2020",
    "lib": ["esnext", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/uni_modules/wot-design-uni/locale": ["./src/shims/wot-locale"]
    },
    "types": ["@dcloudio/types", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "uno.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/uni_modules"]
}
