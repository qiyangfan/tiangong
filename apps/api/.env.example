# ===== 天工 API 环境变量样例（复制为 .env 使用；生产值走密钥系统，禁止入库入仓）=====

# 数据库连接（本地开发指向 ~/workspace/env 共享栈 env-postgres，宿主 5432）
DATABASE_URL=postgresql://tiangong:tiangong_dev@127.0.0.1:5432/tiangong

# JWT access token 签名密钥：>=32 字符随机串（生产必须更换；缺失时应用拒绝启动）
JWT_ACCESS_SECRET=

# token 有效期（秒）：access 15 分钟 / refresh 7 天
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# 登录失败锁定策略
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# CORS 白名单（逗号分隔；生产写实际域名）
CORS_ORIGINS=http://localhost:5173

# 服务端口
PORT=3000

# 基础运行指标：GET /api/v1/metrics（Prometheus 文本）。生产建议在网关层限制抓取来源；
# 无法在网关层限制时置 false 关闭端点
METRICS_ENABLED=true

# 首个管理员密码：仅在 seed 时使用。留空则随机生成并只打印一次。
ADMIN_INITIAL_PASSWORD=

# 本地文件存储目录与上传限制
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# AI 入口（P1，默认关闭）。开启时以下 provider 配置必填；AI_PROVIDER=fake 仅限非生产环境。
# 真实 provider 可指向 muniu 的 /v1 或任意 OpenAI-compatible 端点；密钥只从环境注入。
AI_ENABLED=false
AI_PROVIDER=openai-compatible
# AI_PROVIDER_BASE_URL=http://127.0.0.1:8787/v1
# AI_PROVIDER_API_KEY=
# AI_MODEL=
# AI_MAX_TOKENS=2048
# AI_PROVIDER_TIMEOUT_MS=60000
# AI_TOOL_TIMEOUT_MS=15000
# AI 工具执行以本机 HTTP 自调用平台 API；默认 http://127.0.0.1:${PORT}
# API_SELF_BASE_URL=http://127.0.0.1:3000
