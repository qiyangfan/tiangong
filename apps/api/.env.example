# ===== 天工 API 环境变量样例（复制为 .env 使用；生产值走密钥系统，禁止入库入仓）=====

# 数据库连接（本地开发指向 ~/workspace/env 共享栈 env-mysql）
DATABASE_URL=mysql://tiangong:tiangong_dev@127.0.0.1:3307/tiangong

# JWT access token 签名密钥：>=32 字符随机串（生产必须更换；缺失时应用拒绝启动）
JWT_ACCESS_SECRET=

# token 有效期（秒）：access 15 分钟 / refresh 7 天
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# 登录失败锁定策略
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# CORS 白名单（逗号分隔；生产写实际域名）
CORS_ORIGINS=http://localhost:5173

# 服务端口
PORT=3000

# 基础运行指标：GET /api/v1/metrics（Prometheus 文本）。生产建议在网关层限制抓取来源；
# 无法在网关层限制时置 false 关闭端点
METRICS_ENABLED=true

# 首个管理员密码：仅在 seed 时使用。留空则随机生成并只打印一次。
ADMIN_INITIAL_PASSWORD=

# 本地文件存储目录与上传限制
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=20
