{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "types": [
      "node",
      "multer"
    ]
  },
  "include": [
    "src",
    "test",
    "prisma/seed.ts"
  ]
}
