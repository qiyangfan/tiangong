{
  "name": "tiangong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "天工 — 通用 TS 后台脚手架（NestJS + Vue3 + uni-app）",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"apps/web/src/**/*.{css,vue}\" \"apps/miniapp/src/**/*.{scss,vue}\" --allow-empty-input",
    "lint:md": "markdownlint-cli2",
    "lint:arch": "node scripts/arch-check.mjs",
    "lint:docker": "hadolint apps/api/Dockerfile apps/web/Dockerfile",
    "scan:images": "trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 tiangong-api:latest && trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 tiangong-web:latest",
    "lint:dead": "knip",
    "audit:deps": "pnpm audit --audit-level=high",
    "dup:check": "jscpd apps packages --ignore \"**/node_modules/**,**/dist/**,**/unpackage/**,**/uni_modules/**,**/__tests__/**,apps/api/test/**,apps/api/openapi.snapshot.json\" --reporters console --silent --threshold 4",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:validate": "pnpm --filter @tiangong/api exec prisma validate",
    "schema:format:check": "node scripts/prisma-format-check.mjs",
    "schema:drift": "pnpm --filter @tiangong/api exec prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "license:check": "node scripts/license-check.mjs",
    "sbom:generate": "node scripts/sbom-generate.mjs",
    "pretypecheck": "pnpm --filter @tiangong/contracts build",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "size:check": "node scripts/bundle-budget.mjs",
    "pretest": "pnpm --filter @tiangong/contracts build",
    "test": "pnpm -r run test",
    "pretest:coverage": "pnpm --filter @tiangong/contracts build",
    "test:coverage": "pnpm -r run test:coverage",
    "test:e2e": "pnpm --filter @tiangong/e2e test:e2e",
    "dev:api": "pnpm --filter @tiangong/api dev",
    "dev:web": "pnpm --filter @tiangong/web dev",
    "db:up": "docker compose -f deploy/compose.dev.yaml up -d",
    "db:down": "docker compose -f deploy/compose.dev.yaml down",
    "db:reset": "docker compose -f deploy/compose.dev.yaml down -v",
    "db:migrate": "pnpm --filter @tiangong/api prisma:migrate",
    "db:seed": "pnpm --filter @tiangong/api prisma:seed",
    "gen:crud": "pnpm --filter @tiangong/api exec tsx --env-file-if-exists=.env scripts/gen-crud.ts",
    "docs:links": "python3 scripts/check_md_links.py",
    "spec:validate": "npx --yes @fission-ai/openspec@2.1.0 validate --all --strict"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "markdownlint-cli2": "^0.24.2",
    "postcss-html": "^2.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
